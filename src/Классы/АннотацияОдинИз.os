// Строка - Сообщение, выводимое при невалидном значении
//
Перем _Сообщение;

// Массив Из Строка, Число, Булево, Дата - допустимые значения
Перем _ДопустимыеЗначения;

// Представление имени ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяОграничения() Экспорт
	Возврат "ОдинИз";
КонецФункции

// Сообщение, показываемое при срабатывании ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Сообщение() Экспорт
	Возврат _Сообщение;
КонецФункции

// Код ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Код() Экспорт
	Возврат "oneOf";
КонецФункции

// Допустимые значения.
//
// Возвращаемое значение:
//   Массив Из Строка, Число, Булево, Дата
//
Функция ДопустимыеЗначения() Экспорт
	Возврат _ДопустимыеЗначения;
КонецФункции

// Аннотация ограничения значения свойства или элементов/ключей коллекции.
//
// Проаннотированный элемент должен совпадать с одним из перечисленных значений.
// Сравниваются сами значения, поэтому тип имеет значение: для числового поля
// перечисляют числа, для строкового - строки.
//
// Параметры:
//   Значение    - Строка, Число, Булево, Дата - допустимое значение. Параметр
//                 повторяемый: значения перечисляются повторением параметра.
//
//                   &ОдинИз(Значение = "создан", Значение = "оплачен")
//                   &ОдинИз(Значение = 1, Значение = 2, Значение = 3)
//
//   Сообщение   - Строка - текст сообщения (по умолчанию формируется автоматически).
//
&Аннотация("ОдинИз")
Процедура ПриСозданииОбъекта(&Повторяемый Значение, Сообщение = "")

	_ДопустимыеЗначения = Значение;

	Если Сообщение = "" Тогда
		_Сообщение = "Значение не входит в список допустимых <"
			+ СтрСоединить(_ДопустимыеЗначения, ", ") + ">";
	Иначе
		_Сообщение = Сообщение;
	КонецЕсли;

КонецПроцедуры
