// Директива &ДляКаждого переключает контекст проверки со свойства
// на элементы или ключи коллекции.
#Использовать ".."
#Использовать "."
#Использовать asserts

&Тест
Процедура ДляКаждогоЗначениеОбходитЗначенияСоответствия() Экспорт

	// Дано
	Объект = Новый ОбъектСоСоответствием;
	Объект.СоответствиеСтрок = Новый Соответствие;
	Объект.СоответствиеСтрок.Вставить("ключ1", "ab");
	Объект.СоответствиеСтрок.Вставить("ключ2", "abcd");

	// Когда
	РезультатВалидации = Новый Валидатор().Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ДляКаждогоЗначениеНаходитНарушениеВЭлементе() Экспорт

	// Дано
	Объект = Новый ОбъектСоСоответствием;
	Объект.СоответствиеСтрок = Новый Соответствие;
	Объект.СоответствиеСтрок.Вставить("ключ1", "ab");
	Объект.СоответствиеСтрок.Вставить("ключ2", "слишком длинное значение");

	// Когда
	РезультатВалидации = Новый Валидатор().Валидировать(Объект);

	// Тогда
	// Нарушение относится к свойству целиком: конкретный элемент коллекции
	// в нарушении не указывается.
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(1);
	Ожидаем.Что(РезультатВалидации[0].ИмяСвойства()).Равно("СоответствиеСтрок");
	Ожидаем.Что(РезультатВалидации[0].Код()).Равно("size");

КонецПроцедуры

&Тест
Процедура ДляКаждогоНаходитНарушениеВКаждомЭлементе() Экспорт

	// Дано
	Объект = Новый ОбъектСоСоответствием;
	Объект.СоответствиеСтрок = Новый Соответствие;
	Объект.СоответствиеСтрок.Вставить("ключ1", "a");
	Объект.СоответствиеСтрок.Вставить("ключ2", "слишком длинное значение");

	// Когда
	РезультатВалидации = Новый Валидатор().Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ДляКаждогоПропускаетНезаполненнуюКоллекцию() Экспорт

	// Дано
	// Тип свойства не задан, само свойство не заполнено - обходить нечего.
	Объект = Новый ОбъектСоСоответствием;

	// Когда
	РезультатВалидации = Новый Валидатор().Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ДляКаждогоПропускаетПустуюКоллекцию() Экспорт

	// Дано
	Объект = Новый ОбъектСоСоответствием;
	Объект.СоответствиеСтрок = Новый Соответствие;

	// Когда
	РезультатВалидации = Новый Валидатор().Валидировать(Объект);

