#Область ПрограммныйИнтерфейс

// Число - число, кратным которому должно быть значение
Перем Кратность;

// Инициализирует валидацию параметрами ограничения.
//
// Параметры:
//   пОграничение - АннотацияКратно - ограничение, по которому строится проверка.
//
Процедура Инициализировать(пОграничение) Экспорт
	Кратность = пОграничение.Кратность();
КонецПроцедуры

// Проверяет кратность значения.
//
// Нечисловое значение кратным быть не может: проверять тип - забота ограничения
// &Тип, поэтому здесь такое значение просто не проходит проверку.
//
// Параметры:
//   Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//   Булево - Истина, если значение кратно либо не заполнено.
//
Функция ЗначениеВалидно(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;

	// Через деление, а не через остаток: остаток от деления дробных чисел
	// ведёт себя неочевидно, а кратность бывает и дробной.
	Частное = Значение / Кратность;

	Возврат Цел(Частное) = Частное;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти
