#Использовать logos

#Область ПрограммныйИнтерфейс

// РегулярноеВыражение - проверка значения, Неопределено - формат неизвестен
Перем РегулярноеВыражение;

// Лог - сообщает о неизвестном формате
Перем Лог;

// Инициализирует валидацию параметрами ограничения.
//
// Параметры:
//   пОграничение - АннотацияФормат - ограничение, по которому строится проверка.
//
Процедура Инициализировать(пОграничение) Экспорт

	КодФормата = НРег(СокрЛП(пОграничение.КодФормата()));
	Шаблон = ШаблонФормата(КодФормата);

	Если Шаблон = Неопределено Тогда
		РегулярноеВыражение = Неопределено;
		Лог.Отладка("Формат <%1> неизвестен, значение не проверяется", КодФормата);
	Иначе
		РегулярноеВыражение = Новый РегулярноеВыражение("^(?:" + Шаблон + ")$");
	КонецЕсли;

КонецПроцедуры

// Проверяет соответствие значения известному формату.
//
// Нестроковое значение проверку не проходит: форматы описывают строковое
// представление данных, и приводить к нему число или дату ограничение не вправе.
//
// Параметры:
//   Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//   Булево - Истина, если значение соответствует формату, формат неизвестен
//            либо значение не заполнено.
//
Функция ЗначениеВалидно(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	// Неизвестный формат значение не отбраковывает: список форматов открытый,
	// и разметка полезна как описание поля даже там, где проверить его нечем.
	Если РегулярноеВыражение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат РегулярноеВыражение.Совпадает(Значение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Регулярное выражение известного формата.
//
// Выражения намеренно нестрогие: задача ограничения - отсечь явно непохожее,
// а не заменить собой разбор адреса или даты. Диапазоны месяца и дня при этом
// проверяются, чтобы не пропускать заведомо несуществующие даты.
//
// Параметры:
//   КодФормата - Строка - код формата в нижнем регистре.
//
// Возвращаемое значение:
//   Строка, Неопределено - выражение либо Неопределено, если формат неизвестен.
//
Функция ШаблонФормата(КодФормата)

	Месяц = "(0[1-9]|1[0-2])";
	День = "(0[1-9]|[12]\d|3[01])";
	Время = "([01]\d|2[0-3]):[0-5]\d:[0-5]\d";

	Шаблоны = Новый Соответствие();
	Шаблоны.Вставить("email", "[^@\s]+@[^@\s]+\.[^@\s]+");
	Шаблоны.Вставить("uuid",
		"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}");
	Шаблоны.Вставить("uri", "[a-zA-Z][a-zA-Z0-9+.\-]*:\S+");
	Шаблоны.Вставить("date", "\d{4}-" + Месяц + "-" + День);
	Шаблоны.Вставить("date-time",
		"\d{4}-" + Месяц + "-" + День + "[Tt ]" + Время + "(\.\d+)?([Zz]|[+\-]([01]\d|2[0-3]):[0-5]\d)?");
	Шаблоны.Вставить("ipv4", "((25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\.){3}(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)");

	Возврат Шаблоны.Получить(КодФормата);

КонецФункции

Процедура ПриСозданииОбъекта()
	Лог = Логирование.ПолучитьЛог("oscript.lib.validate.ВалидацияОграниченияФормат");
КонецПроцедуры

#КонецОбласти
