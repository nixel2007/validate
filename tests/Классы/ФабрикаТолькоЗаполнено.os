// Урезанная фабрика валидаций для проверки того, что валидатор действительно
// обращается к переданной ему фабрике: распознаёт единственное ограничение
// &Заполнено, все остальные аннотации для неё - не ограничения.

Функция ЭтоАннотацияВалидации(ИмяАннотации) Экспорт
	Возврат НРег(ИмяАннотации) = "заполнено";
КонецФункции

Функция СоздатьОбъектВалидации(Ограничение) Экспорт

	Валидация = Новый ВалидацияОграниченияЗаполнено;
	Валидация.Инициализировать(Ограничение);

	Возврат Валидация;

КонецФункции
