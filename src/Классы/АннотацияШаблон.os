// Строка - Сообщение, выводимое при невалидном значении
//
Перем _Сообщение;

// Регулярное выражение, которому должно соответствовать значение
Перем _Шаблон;

// Представление имени ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяОграничения() Экспорт
	Возврат "Шаблон";
КонецФункции

// Сообщение, показываемое при срабатывании ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Сообщение() Экспорт
	Возврат _Сообщение;
КонецФункции

// Код ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Код() Экспорт
	Возврат "pattern";
КонецФункции

// Регулярное выражение, которому должно соответствовать значение.
//
// Возвращаемое значение:
//   Строка
//
Функция Шаблон() Экспорт
	Возврат _Шаблон;
КонецФункции

// Аннотация ограничения значения свойства или элементов/ключей коллекции.
//
// Проаннотированный элемент должен соответствовать регулярному выражению.
// Значение проверяется целиком: выражение неявно привязано к началу и концу
// строки, поэтому "\d+" не пропустит "abc123".
//
// Параметры:
//   Значение    - Строка - регулярное выражение.
//   Сообщение   - Строка - текст сообщения (по умолчанию формируется автоматически).
//
&Аннотация("Шаблон")
Процедура ПриСозданииОбъекта(Значение, Сообщение = "")
	_Шаблон = Значение;
	Если Сообщение = "" Тогда
		_Сообщение = "Значение не соответствует шаблону <" + _Шаблон + ">";
	Иначе
		_Сообщение = Сообщение;
	КонецЕсли;
КонецПроцедуры
