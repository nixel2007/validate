#Область ПрограммныйИнтерфейс

// Массив Из Строка, Число, Булево, Дата - допустимые значения
Перем ДопустимыеЗначения;

// Инициализирует валидацию параметрами ограничения.
//
// Параметры:
//   пОграничение - АннотацияОдинИз - ограничение, по которому строится проверка.
//
Процедура Инициализировать(пОграничение) Экспорт
	ДопустимыеЗначения = пОграничение.ДопустимыеЗначения();
КонецПроцедуры

// Проверяет, входит ли значение в список допустимых.
//
// Сравниваются сами значения, без приведения к строке: число 1 и строка "1" -
// разные значения, и считать их одинаковыми ограничение не вправе.
//
// Параметры:
//   Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//   Булево - Истина, если значение допустимо либо не заполнено.
//
Функция ЗначениеВалидно(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ДопустимыеЗначения.Найти(Значение) <> Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти
