#Область ПрограммныйИнтерфейс

Перем ДопустимыеЗначения;

Процедура Инициализировать(пОграничение) Экспорт
	ДопустимыеЗначения = пОграничение.ДопустимыеЗначения();
КонецПроцедуры

Функция ЗначениеВалидно(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ДопустимыеЗначения.Найти(Строка(Значение)) <> Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти
