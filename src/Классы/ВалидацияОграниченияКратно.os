#Область ПрограммныйИнтерфейс

Перем Кратность;

Процедура Инициализировать(пОграничение) Экспорт
	Кратность = пОграничение.Кратность();
КонецПроцедуры

Функция ЗначениеВалидно(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	// Кратность нулю не определена: на ноль не делят, и ни одно значение
	// такому ограничению осмысленно не удовлетворяет.
	Если Кратность = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Число = ЧислоИзЗначения(Значение);

	Если Число = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// Через деление, а не через остаток: остаток от деления дробных чисел
	// ведёт себя неочевидно, а кратность бывает и дробной.
	Частное = Число / Кратность;

	Возврат Цел(Частное) = Частное;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Нечисловое значение кратным быть не может. Проверять его тип - забота
// ограничения &Тип, поэтому здесь достаточно не упасть.
Функция ЧислоИзЗначения(Значение)

	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти
