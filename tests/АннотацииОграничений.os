// Метаданные аннотаций-ограничений: имя, по которому фабрика подбирает валидацию,
// код нарушения и сообщение по умолчанию.
#Использовать ".."
#Использовать "."
#Использовать asserts

&Тест
Процедура ИменаОграниченийСовпадаютСИменамиАннотаций() Экспорт

	Ожидаем.Что(Новый АннотацияВалидно().ИмяОграничения()).Равно("Валидно");
	Ожидаем.Что(Новый АннотацияЗаполнено().ИмяОграничения()).Равно("Заполнено");
	Ожидаем.Что(Новый АннотацияИстина().ИмяОграничения()).Равно("Истина");
	Ожидаем.Что(Новый АннотацияЛожь().ИмяОграничения()).Равно("Ложь");
	Ожидаем.Что(Новый АннотацияКратно(2).ИмяОграничения()).Равно("Кратно");
	Ожидаем.Что(Новый АннотацияМаксимум(1).ИмяОграничения()).Равно("Максимум");
	Ожидаем.Что(Новый АннотацияМинимум(1).ИмяОграничения()).Равно("Минимум");
	Ожидаем.Что(НовоеОграничениеОдинИз().ИмяОграничения()).Равно("ОдинИз");
	Ожидаем.Что(Новый АннотацияРазмер(1).ИмяОграничения()).Равно("Размер");
	Ожидаем.Что(Новый АннотацияТип("Число").ИмяОграничения()).Равно("Тип");
	Ожидаем.Что(Новый АннотацияФормат("email").ИмяОграничения()).Равно("Формат");
	Ожидаем.Что(Новый АннотацияШаблон("\d+").ИмяОграничения()).Равно("Шаблон");

КонецПроцедуры

&Тест
Процедура КодыНарушенийСтабильны() Экспорт

	// Код нарушения - часть публичного контракта: по нему потребитель
	// разбирает результат валидации.
	Ожидаем.Что(Новый АннотацияВалидно().Код()).Равно("valid");
	Ожидаем.Что(Новый АннотацияЗаполнено().Код()).Равно("filled");
	Ожидаем.Что(Новый АннотацияИстина().Код()).Равно("true");
	Ожидаем.Что(Новый АннотацияЛожь().Код()).Равно("false");
	Ожидаем.Что(Новый АннотацияКратно(2).Код()).Равно("multipleOf");
	Ожидаем.Что(Новый АннотацияМаксимум(1).Код()).Равно("max");
	Ожидаем.Что(Новый АннотацияМинимум(1).Код()).Равно("min");
	Ожидаем.Что(НовоеОграничениеОдинИз().Код()).Равно("oneOf");
	Ожидаем.Что(Новый АннотацияРазмер(1).Код()).Равно("size");
	Ожидаем.Что(Новый АннотацияТип("Число").Код()).Равно("type");
	Ожидаем.Что(Новый АннотацияФормат("email").Код()).Равно("format");
	Ожидаем.Что(Новый АннотацияШаблон("\d+").Код()).Равно("pattern");

КонецПроцедуры

&Тест
Процедура СообщенияПоУмолчаниюОписываютОграничение() Экспорт

	Ожидаем.Что(Новый АннотацияВалидно().Сообщение()).Равно("Значение не валидно");
	Ожидаем.Что(Новый АннотацияЗаполнено().Сообщение()).Равно("Значение не заполнено");
	Ожидаем.Что(Новый АннотацияМинимум(-10).Сообщение()).Равно("Значение меньше минимального <-10>");
	Ожидаем.Что(Новый АннотацияМаксимум(10).Сообщение()).Равно("Значение больше максимального <10>");
	// Разделитель дробной части зависит от локали, поэтому проверяется только начало.
	Ожидаем.Что(Новый АннотацияКратно(0.5).Сообщение()).Содержит("Значение не кратно <");
	Ожидаем.Что(Новый АннотацияКратно(2).Сообщение()).Равно("Значение не кратно <2>");
	Ожидаем.Что(Новый АннотацияШаблон("\d+").Сообщение()).Равно("Значение не соответствует шаблону <\d+>");
	Ожидаем.Что(Новый АннотацияФормат("email").Сообщение()).Равно("Значение не соответствует формату <email>");
	Ожидаем.Что(НовоеОграничениеОдинИз().Сообщение()).Равно("Значение не входит в список допустимых <создан, оплачен>");

КонецПроцедуры

&Тест
Процедура СообщениеМожноЗадатьЯвноВЛюбомОграничении() Экспорт

	Ожидаем.Что(Новый АннотацияВалидно("Своё").Сообщение()).Равно("Своё");
	Ожидаем.Что(Новый АннотацияЗаполнено("Своё").Сообщение()).Равно("Своё");
	Ожидаем.Что(Новый АннотацияИстина("Своё").Сообщение()).Равно("Своё");
	Ожидаем.Что(Новый АннотацияЛожь("Своё").Сообщение()).Равно("Своё");
	Ожидаем.Что(Новый АннотацияКратно(2, "Своё").Сообщение()).Равно("Своё");
	Ожидаем.Что(Новый АннотацияМаксимум(1, "Своё").Сообщение()).Равно("Своё");
	Ожидаем.Что(Новый АннотацияМинимум(1, "Своё").Сообщение()).Равно("Своё");
	Ожидаем.Что(Новый АннотацияТип("Число", "Своё").Сообщение()).Равно("Своё");
	Ожидаем.Что(Новый АннотацияФормат("email", "Своё").Сообщение()).Равно("Своё");
	Ожидаем.Что(Новый АннотацияШаблон("\d+", "Своё").Сообщение()).Равно("Своё");
	Ожидаем.Что(НовоеОграничениеОдинИз("Своё").Сообщение()).Равно("Своё");

КонецПроцедуры

&Тест
Процедура ОграниченияОтдаютСвоиПараметры() Экспорт

	Ожидаем.Что(Новый АннотацияМинимум(-10).Минимум()).Равно(-10);
	Ожидаем.Что(Новый АннотацияМаксимум(10).Максимум()).Равно(10);
	Ожидаем.Что(Новый АннотацияКратно(0.5).Кратность()).Равно(0.5);
	Ожидаем.Что(Новый АннотацияРазмер(2, 5).Минимум()).Равно(2);
	Ожидаем.Что(Новый АннотацияРазмер(2, 5).Максимум()).Равно(5);
	Ожидаем.Что(Новый АннотацияТип("Число").ТипЗначения()).Равно(Тип("Число"));
	Ожидаем.Что(Новый АннотацияФормат("email").КодФормата()).Равно("email");
	Ожидаем.Что(Новый АннотацияШаблон("\d+").Шаблон()).Равно("\d+");
	Ожидаем.Что(НовоеОграничениеОдинИз().ДопустимыеЗначения()).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ДляКаждогоПоУмолчаниюОбходитЗначения() Экспорт

	Ожидаем.Что(Новый АннотацияДляКаждого().Режим()).Равно("Значение");
	Ожидаем.Что(Новый АннотацияДляКаждого("Ключ").Режим()).Равно("Ключ");

КонецПроцедуры

// Значения ограничения &ОдинИз объявляются повторяемым параметром аннотации,
// а при прямом создании передаются массивом.
Функция НовоеОграничениеОдинИз(Сообщение = "")

	ДопустимыеЗначения = Новый Массив;
	ДопустимыеЗначения.Добавить("создан");
	ДопустимыеЗначения.Добавить("оплачен");

	Возврат Новый АннотацияОдинИз(ДопустимыеЗначения, Сообщение);

КонецФункции
