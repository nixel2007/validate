// Известные коды ограничения &Формат: uri, date, date-time, ipv4.
// Форматы email и uuid проверяются в наборе Валидатор.
#Использовать ".."
#Использовать "."
#Использовать asserts

&Тест
Процедура ФорматПропускаетНезаполненныеЗначения() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектСФорматами;

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ФорматURIПропускаетСсылку() Экспорт

	Объект = Новый ОбъектСФорматами;
	Объект.Ссылка = "https://github.com/nixel2007/validate";

	Ожидаем.Что(Новый Валидатор().Валидировать(Объект)).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ФорматURIОтклоняетСтрокуБезСхемы() Экспорт

	Объект = Новый ОбъектСФорматами;
	Объект.Ссылка = "github.com/nixel2007/validate";

	РезультатВалидации = Новый Валидатор().Валидировать(Объект);

	Ожидаем.Что(РезультатВалидации).ИмеетДлину(1);
	Ожидаем.Что(РезультатВалидации[0].ИмяСвойства()).Равно("Ссылка");
	Ожидаем.Что(РезультатВалидации[0].Код()).Равно("format");
	Ожидаем.Что(РезультатВалидации[0].Сообщение()).Равно("Значение не соответствует формату <uri>");

КонецПроцедуры

&Тест
Процедура ФорматDateПропускаетДату() Экспорт

	Объект = Новый ОбъектСФорматами;
	Объект.ДатаСтрокой = "2024-02-29";

	Ожидаем.Что(Новый Валидатор().Валидировать(Объект)).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ФорматDateОтклоняетНесуществующийМесяц() Экспорт

	Объект = Новый ОбъектСФорматами;
	Объект.ДатаСтрокой = "2024-13-01";

	РезультатВалидации = Новый Валидатор().Валидировать(Объект);

	Ожидаем.Что(РезультатВалидации).ИмеетДлину(1);
	Ожидаем.Что(РезультатВалидации[0].ИмяСвойства()).Равно("ДатаСтрокой");

КонецПроцедуры

&Тест
Процедура ФорматDateОтклоняетДатуСВременем() Экспорт

	// Ограничение проверяет значение целиком, поэтому "дата плюс что-то ещё"
	// формату date не соответствует.
	Объект = Новый ОбъектСФорматами;
	Объект.ДатаСтрокой = "2024-01-31T10:00:00";

	Ожидаем.Что(Новый Валидатор().Валидировать(Объект)).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ФорматDateTimeПропускаетМоментВремениСЗоной() Экспорт

	Объект = Новый ОбъектСФорматами;
	Объект.МоментВремени = "2024-01-31T23:59:59Z";

	Ожидаем.Что(Новый Валидатор().Валидировать(Объект)).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ФорматDateTimeПропускаетМоментВремениСоСмещением() Экспорт

	Объект = Новый ОбъектСФорматами;
	Объект.МоментВремени = "2024-01-31 23:59:59.123+03:00";

	Ожидаем.Что(Новый Валидатор().Валидировать(Объект)).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ФорматDateTimeОтклоняетНекорректноеВремя() Экспорт

	Объект = Новый ОбъектСФорматами;
	Объект.МоментВремени = "2024-01-31T24:00:00";

	Ожидаем.Что(Новый Валидатор().Валидировать(Объект)).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ФорматIPv4ПропускаетАдрес() Экспорт

	Объект = Новый ОбъектСФорматами;
	Объект.Адрес = "192.168.0.1";

	Ожидаем.Что(Новый Валидатор().Валидировать(Объект)).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ФорматIPv4ОтклоняетОктетБольше255() Экспорт

	Объект = Новый ОбъектСФорматами;
	Объект.Адрес = "256.1.1.1";

	Ожидаем.Что(Новый Валидатор().Валидировать(Объект)).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ФорматIPv4ОтклоняетНестроку() Экспорт

	// Форматы описывают строковое представление данных, поэтому число
	// проверку не проходит.
	Объект = Новый ОбъектСФорматами;
	Объект.Адрес = 42;

	Ожидаем.Что(Новый Валидатор().Валидировать(Объект)).ИмеетДлину(1);

КонецПроцедуры
