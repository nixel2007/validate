// Строка - Сообщение, выводимое при невалидном значении
//
Перем _Сообщение;

// Наименьший допустимый размер значения
Перем _Минимум;

// Наибольший допустимый размер значения, 0 - без ограничения сверху
Перем _Максимум;

// Представление имени ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяОграничения() Экспорт
	Возврат "Размер";
КонецФункции

// Сообщение, показываемое при срабатывании ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Сообщение() Экспорт
	Возврат _Сообщение;
КонецФункции

// Код ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Код() Экспорт
	Возврат "size";
КонецФункции

// Наименьший допустимый размер значения.
//
// Возвращаемое значение:
//   Число
//
Функция Минимум() Экспорт
	Возврат _Минимум;
КонецФункции

// Наибольший допустимый размер значения. Ноль означает отсутствие ограничения сверху.
//
// Возвращаемое значение:
//   Число
//
Функция Максимум() Экспорт
	Возврат _Максимум;
КонецФункции

// Аннотация ограничения размера свойства или элементов/ключей коллекции.
//
// Размером считается длина строки либо количество элементов коллекции -
// массива, структуры или соответствия.
//
// Отличается от &Минимум и &Максимум, которые сравнивают само значение:
// &Максимум(10) для строки сравнивает её лексикографически, а &Размер(Максимум = 10)
// ограничивает её длину.
//
// Параметры:
//   Минимум     - Число  - наименьший допустимый размер (включительно).
//   Максимум    - Число  - наибольший допустимый размер (включительно).
//                          Ноль означает отсутствие ограничения сверху.
//   Сообщение   - Строка - текст сообщения (по умолчанию формируется автоматически).
//
&Аннотация("Размер")
Процедура ПриСозданииОбъекта(Минимум = 0, Максимум = 0, Сообщение = "")
	_Минимум = Минимум;
	_Максимум = Максимум;
	Если Сообщение = "" Тогда
		_Сообщение = СообщениеПоУмолчанию();
	Иначе
		_Сообщение = Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция СообщениеПоУмолчанию()

	Если _Максимум = 0 Тогда
		Возврат "Размер значения меньше <" + Формат(_Минимум, "ЧГ=0; ЧН=0") + ">";
	КонецЕсли;

	Возврат "Размер значения вне диапазона <" + Формат(_Минимум, "ЧГ=0; ЧН=0")
		+ ".." + Формат(_Максимум, "ЧГ=0; ЧН=0") + ">";

КонецФункции
