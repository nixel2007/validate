#Область Шаблон

&Тест
Процедура ШаблонПроверяетЗначениеЦеликом() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияШаблон("\d{3}"));

	Ожидаем.Что(Валидация.ЗначениеВалидно("123")).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно("а123я")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ШаблонПропускаетНеопределеноИОтклоняетНестроку() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияШаблон("\d+"));

	Ожидаем.Что(Валидация.ЗначениеВалидно(Неопределено)).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(123)).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Формат

&Тест
Процедура ФорматПропускаетНеизвестныйКод() Экспорт

	// Список форматов открытый: то, что библиотека проверить не умеет,
	// она и не отбраковывает.
	Валидация = НоваяВалидация(Новый АннотацияФормат("хитрый-формат"));

	Ожидаем.Что(Валидация.ЗначениеВалидно("что угодно")).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(42)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФорматНеЧувствителенКРегиструКода() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияФормат("  EMAIL "));

	Ожидаем.Что(Валидация.ЗначениеВалидно("nixel2007@gmail.com")).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно("не почта")).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяВалидация(Ограничение)
	Возврат Новый СтандартнаяФабрикаВалидаций(Новый Валидатор).СоздатьОбъектВалидации(Ограничение);
КонецФункции

Функция МассивИзЭлементов(Количество)

	Массив = Новый Массив;
	Для Индекс = 1 По Количество Цикл
		Массив.Добавить(Индекс);
	КонецЦикла;

	Возврат Массив;

КонецФункции

Функция МассивИзЗначений(Знач Первое, Знач Второе)

	Массив = Новый Массив;
	Массив.Добавить(Первое);
	Массив.Добавить(Второе);

	Возврат Массив;

КонецФункции

#КонецОбласти
