// Строка - Сообщение, выводимое при невалидном значении
//
Перем _Сообщение;

// Массив Из Строка - допустимые значения
Перем _ДопустимыеЗначения;

// Представление имени ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяОграничения() Экспорт
	Возврат "ОдинИз";
КонецФункции

// Сообщение, показываемое при срабатывании ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Сообщение() Экспорт
	Возврат _Сообщение;
КонецФункции

// Код ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Код() Экспорт
	Возврат "oneOf";
КонецФункции

// Допустимые значения.
//
// Возвращаемое значение:
//   Массив Из Строка
//
Функция ДопустимыеЗначения() Экспорт
	Возврат _ДопустимыеЗначения;
КонецФункции

// Аннотация ограничения значения свойства или элементов/ключей коллекции.
//
// Проаннотированный элемент должен совпадать с одним из перечисленных значений.
// Сравнение строковое: значение приводится к строке, поэтому ограничение
// работает и для чисел.
//
// Параметр Значение повторяемый - допустимые значения перечисляются повторением
// параметра, и в конструктор приходят массивом:
//
//   &ОдинИз(Значение = "создан", Значение = "оплачен", Значение = "отгружен")
//
// Параметры:
//   Значение    - Массив Из Строка - допустимые значения.
//   Сообщение   - Строка - текст сообщения (по умолчанию формируется автоматически).
//
&Аннотация("ОдинИз")
Процедура ПриСозданииОбъекта(&Повторяемый Значение, Сообщение = "")

	_ДопустимыеЗначения = Новый Массив();

	Для Каждого ДопустимоеЗначение Из Значение Цикл
		_ДопустимыеЗначения.Добавить(Строка(ДопустимоеЗначение));
	КонецЦикла;

	Если Сообщение = "" Тогда
		_Сообщение = "Значение не входит в список допустимых <"
			+ СтрСоединить(_ДопустимыеЗначения, ", ") + ">";
	Иначе
		_Сообщение = Сообщение;
	КонецЕсли;

КонецПроцедуры
