#Область ПрограммныйИнтерфейс

// РегулярноеВыражение - проверка значения
Перем РегулярноеВыражение;

// Инициализирует валидацию параметрами ограничения.
//
// Параметры:
//   пОграничение - АннотацияШаблон - ограничение, по которому строится проверка.
//
Процедура Инициализировать(пОграничение) Экспорт
	// Выражение привязывается к началу и концу строки: ограничение говорит,
	// какому виду соответствует значение целиком, а не что оно где-то внутри
	// содержит подходящий кусок.
	РегулярноеВыражение = Новый РегулярноеВыражение("^(?:" + пОграничение.Шаблон() + ")$");
КонецПроцедуры

// Проверяет соответствие значения регулярному выражению.
//
// Нестроковое значение проверку не проходит: приводить его к строке значило бы
// проверять представление вместо самого значения, а какое оно у числа или даты -
// зависит от настроек, и ограничение стало бы непредсказуемым.
//
// Параметры:
//   Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//   Булево - Истина, если значение соответствует шаблону либо не заполнено.
//
Функция ЗначениеВалидно(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат РегулярноеВыражение.Совпадает(Значение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти
