// Ограничения &Истина и &Ложь: единственные ограничения, которые не пропускают
// Неопределено, поэтому проверяем и заполненные значения, и незаполненные.
#Использовать ".."
#Использовать "."
#Использовать asserts

&Тест
Процедура ОграниченияБулевоПропускаютВерныеЗначения() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектСФлагами;
	Объект.Согласен = Истина;
	Объект.Заблокирован = Ложь;

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ОграничениеИстинаОтклоняетЛожь() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектСФлагами;
	Объект.Согласен = Ложь;
	Объект.Заблокирован = Ложь;

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(1);
	Ожидаем.Что(РезультатВалидации[0].ИмяСвойства()).Равно("Согласен");
	Ожидаем.Что(РезультатВалидации[0].Код()).Равно("true");
	Ожидаем.Что(РезультатВалидации[0].Сообщение()).Равно("Значение не равно ""Истина""");

КонецПроцедуры

&Тест
Процедура ОграничениеЛожьОтклоняетИстину() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектСФлагами;
	Объект.Согласен = Истина;
	Объект.Заблокирован = Истина;

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(1);
	Ожидаем.Что(РезультатВалидации[0].ИмяСвойства()).Равно("Заблокирован");
	Ожидаем.Что(РезультатВалидации[0].Код()).Равно("false");
	Ожидаем.Что(РезультатВалидации[0].Сообщение()).Равно("Значение не равно ""Ложь""");

КонецПроцедуры

&Тест
Процедура ОграниченияБулевоОтклоняютНеопределено() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектСФлагами;

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);

	// Тогда
	// Незаполненное булево - это не Истина и не Ложь, поэтому нарушены оба ограничения.
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(2);
	Ожидаем.Что(РезультатВалидации[0].Код()).Равно("true");
	Ожидаем.Что(РезультатВалидации[1].Код()).Равно("false");

КонецПроцедуры

&Тест
Процедура ОграниченияБулевоОтклоняютСтроки() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектСФлагами;
	// Строковое представление булева - не булево: ограничение сравнивает значения,
	// а не их представления.
	Объект.Согласен = "Истина";
	Объект.Заблокирован = "Ложь";

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(2);
	Ожидаем.Что(РезультатВалидации[0].Код()).Равно("true");
	Ожидаем.Что(РезультатВалидации[1].Код()).Равно("false");

КонецПроцедуры
