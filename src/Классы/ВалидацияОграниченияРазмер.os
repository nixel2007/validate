#Область ПрограммныйИнтерфейс

// Число - наименьший допустимый размер значения
Перем Минимум;

// Число - наибольший допустимый размер значения, 0 - без ограничения сверху
Перем Максимум;

// Инициализирует валидацию параметрами ограничения.
//
// Параметры:
//   пОграничение - АннотацияРазмер - ограничение, по которому строится проверка.
//
Процедура Инициализировать(пОграничение) Экспорт
	Минимум = пОграничение.Минимум();
	Максимум = пОграничение.Максимум();
КонецПроцедуры

// Проверяет размер значения, см. РазмерЗначения.
//
// Параметры:
//   Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//   Булево - Истина, если размер в заданных границах либо значение не заполнено.
//
Функция ЗначениеВалидно(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Размер = РазмерЗначения(Значение);

	Если Размер < Минимум Тогда
		Возврат Ложь;
	КонецЕсли;

	// Ноль сверху означает отсутствие ограничения: иначе пришлось бы указывать
	// заведомо большое число там, где верхней границы просто нет.
	Возврат Максимум = 0 ИЛИ Размер <= Максимум;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Размер значения: число элементов для коллекции, длина строкового
// представления для всего остального.
//
// Коллекция определяется по наличию метода Количество, а не по списку типов:
// так ограничение работает и с коллекциями из сторонних библиотек.
//
// Параметры:
//   Значение - Произвольный - значение, размер которого определяется.
//
// Возвращаемое значение:
//   Число - размер значения.
//
Функция РазмерЗначения(Значение)

	Попытка
		Возврат Значение.Количество();
	Исключение
		Возврат СтрДлина(Строка(Значение));
	КонецПопытки;

КонецФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти
