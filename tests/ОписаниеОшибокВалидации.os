// Человекочитаемое описание нарушений: по строке на нарушение,
// в порядке их обнаружения.
#Использовать ".."
#Использовать "."
#Использовать asserts

&Тест
Процедура ОписаниеПустогоРезультатаПустое() Экспорт

	// Дано
	Валидатор = Новый Валидатор;

	// Когда
	Описание = Валидатор.ОписаниеОшибокВалидации(Новый Массив);

	// Тогда
	Ожидаем.Что(Описание).Равно("");

КонецПроцедуры

&Тест
Процедура ОписаниеОдногоНарушенияСодержитКодСвойствоИСообщение() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектДляОписания;
	Объект.Возраст = 42;

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);
	Описание = Валидатор.ОписаниеОшибокВалидации(РезультатВалидации);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(1);
	Ожидаем.Что(Описание).Равно(
		"[filled]: Объект: ОбъектДляОписания, Свойство: Имя, Сообщение: Значение не заполнено"
		+ Символы.ПС
	);

КонецПроцедуры

&Тест
Процедура ОписаниеСодержитСтрокуНаКаждоеНарушение() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектДляОписания;
	Объект.Возраст = "сорок";

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);
	Описание = Валидатор.ОписаниеОшибокВалидации(РезультатВалидации);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(2);

	Строки = СтрРазделить(СокрП(Описание), Символы.ПС, Ложь);
	Ожидаем.Что(Строки).ИмеетДлину(2);
	Ожидаем.Что(Строки[0]).Содержит("[filled]");
	Ожидаем.Что(Строки[0]).Содержит("Свойство: Имя");
	Ожидаем.Что(Строки[1]).Содержит("[type]");
	Ожидаем.Что(Строки[1]).Содержит("Свойство: Возраст");
	Ожидаем.Что(Строки[1]).Содержит("Сообщение: Тип значения отличается от допустимого <");

КонецПроцедуры

&Тест
Процедура ОписаниеСодержитИсходныйТипОбъекта() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектДляОписания;
	Объект.Возраст = 42;

	// Когда
	Описание = Валидатор.ОписаниеОшибокВалидации(Валидатор.Валидировать(Объект));

	// Тогда
	Ожидаем.Что(Описание).Содержит("Объект: ОбъектДляОписания");

КонецПроцедуры
