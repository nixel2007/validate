// Как валидатор относится к свойствам, размеченным не им.
#Использовать ".."
#Использовать "."
#Использовать asserts

&Тест
Процедура СвойстваБезОграниченийНеПроверяются() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектБезОграничений;

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);

	// Тогда
	// У объекта есть свойство совсем без аннотаций и свойство с аннотацией,
	// не зарегистрированной в контейнере: ни то, ни другое валидатора не касается.
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ЧужиеАннотацииНеМешаютПроверятьОстальное() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Объект = Новый ОбъектБезОграничений;
	Объект.ПолеБезАннотаций = "любое значение";
	Объект.ПолеСЧужойАннотацией = "любое значение";

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ОграничениеВалидноПроверяетВложенныйОбъектРекурсивно() Экспорт

	// Дано
	Валидатор = Новый Валидатор;

	Вложенный = Новый ТестовыйОбъект;
	Вложенный.Поле1 = "Значение1";
	Вложенный.Поле2 = "Значение2";

	Объект = Новый ТестовыйОбъект;
	Объект.Поле1 = "Значение1";
	Объект.Поле2 = "Значение2";
	Объект.ВложенныйОбъект = Вложенный;

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);

	// Тогда
	// Вложенный объект валиден, поэтому нарушений нет и у внешнего.
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(0);

КонецПроцедуры
