// Строка - Сообщение, выводимое при невалидном значении
//
Перем _Сообщение;

// Имя формата, которому должно соответствовать значение
Перем _Формат;

// Представление имени ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяОграничения() Экспорт
	Возврат "Формат";
КонецФункции

// Сообщение, показываемое при срабатывании ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Сообщение() Экспорт
	Возврат _Сообщение;
КонецФункции

// Код ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Код() Экспорт
	Возврат "format";
КонецФункции

// Имя формата, которому должно соответствовать значение.
//
// Названо ИмяФормата, а не Формат: Формат - встроенная функция, и методом
// с таким именем сценарий не компилируется.
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяФормата() Экспорт
	Возврат _Формат;
КонецФункции

// Аннотация ограничения значения свойства или элементов/ключей коллекции.
//
// Проаннотированный элемент должен соответствовать известному формату.
// Поддерживаются: email, uuid, uri, date, date-time, ipv4.
//
// Список форматов намеренно открытый: неизвестное имя формата значение
// не отбраковывает. Формат - это ещё и способ описать поле для потребителя,
// и ограничивать разметку тем, что библиотека умеет проверять, незачем.
//
// Параметры:
//   Значение    - Строка - имя формата.
//   Сообщение   - Строка - текст сообщения (по умолчанию формируется автоматически).
//
&Аннотация("Формат")
Процедура ПриСозданииОбъекта(Значение, Сообщение = "")
	_Формат = Значение;
	Если Сообщение = "" Тогда
		_Сообщение = "Значение не соответствует формату <" + _Формат + ">";
	Иначе
		_Сообщение = Сообщение;
	КонецЕсли;
КонецПроцедуры
