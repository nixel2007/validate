&Тест
Процедура ДляКаждогоСНеизвестнымРежимомВызываетИсключение() Экспорт

	// Дано
	Объект = Новый ОбъектСНеизвестнымРежимом;
	Объект.Коллекция = Новый Массив;
	Объект.Коллекция.Добавить(1);

	// Когда
	Валидатор = Новый Валидатор;

	ОшибкаВозникла = Ложь;
	Попытка
		Валидатор.Валидировать(Объект);
	Исключение
		ОшибкаВозникла = Истина;
	КонецПопытки;

	// Тогда
	// Неизвестный режим - ошибка разметки, и молчать о ней нельзя.
	Ожидаем.Что(ОшибкаВозникла).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДляКаждогоСНеизвестнымРежимомМолчитНаПустойКоллекции() Экспорт

	// Дано
	// Режим проверяется при обходе элементов, поэтому обходить нечего -
	// значит и падать не на чем.
	Объект = Новый ОбъектСНеизвестнымРежимом;
	Объект.Коллекция = Новый Массив;

	// Когда
	РезультатВалидации = Новый Валидатор().Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(0);

КонецПроцедуры
