// Фабрика валидаций, объект нарушения и точки расширения валидатора.
#Использовать ".."
#Использовать "."
#Использовать annotations
#Использовать asserts

&Тест
Процедура НарушениеХранитПереданныеЗначения() Экспорт

	// Дано
	Объект = Новый ОбъектДляОписания;

	// Когда
	Нарушение = Новый Нарушение(Объект, "Имя", "Сообщение об ошибке", "code");

	// Тогда
	Ожидаем.Что(Нарушение.Объект()).Равно(Объект);
	Ожидаем.Что(Нарушение.ИмяСвойства()).Равно("Имя");
	Ожидаем.Что(Нарушение.Сообщение()).Равно("Сообщение об ошибке");
	Ожидаем.Что(Нарушение.Код()).Равно("code");

КонецПроцедуры

&Тест
Процедура ФабрикаЗнаетСтандартныеОграничения() Экспорт

	// Дано
	Фабрика = НоваяФабрика();

	// Тогда
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Валидно")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Заполнено")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Истина")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Ложь")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Кратно")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Максимум")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Минимум")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("ОдинИз")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Размер")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Тип")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Формат")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("Шаблон")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФабрикаНеСчитаетОграничениямиПрочиеАннотации() Экспорт

	// Дано
	Фабрика = НоваяФабрика();

	// Тогда
	// &ДляКаждого - директива обхода коллекции, а не ограничение.
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("ДляКаждого")).ЭтоЛожь();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("НеизвестнаяАннотация")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ФабрикаНеЧувствительнаКРегистру() Экспорт

	// Дано
	Фабрика = НоваяФабрика();

	// Тогда
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("заполнено")).ЭтоИстина();
	Ожидаем.Что(Фабрика.ЭтоАннотацияВалидации("ЗАПОЛНЕНО")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФабрикаСоздаётИнициализированнуюВалидацию() Экспорт

	// Дано
	Фабрика = НоваяФабрика();

	// Когда
	Валидация = Фабрика.СоздатьОбъектВалидации(Новый АннотацияРазмер(2, 4));

	// Тогда
	Ожидаем.Что(ТипЗнч(Валидация)).Равно(Тип("ВалидацияОграниченияРазмер"));
	Ожидаем.Что(Валидация.ЗначениеВалидно("abc")).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно("a")).ЭтоЛожь();
	Ожидаем.Что(Валидация.ЗначениеВалидно("abcde")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ФабрикаПередаётВалидаторВложеннойВалидации() Экспорт

	// Дано
	Валидатор = Новый Валидатор;
	Фабрика = Новый СтандартнаяФабрикаВалидаций(Валидатор);

	Валидный = Новый ОбъектДляОписания;
	Валидный.Имя = "Имя";
	Валидный.Возраст = 42;

	Невалидный = Новый ОбъектДляОписания;

	// Когда
	// Ограничение &Валидно умеет работать только с внедрённым валидатором.
	Валидация = Фабрика.СоздатьОбъектВалидации(Новый АннотацияВалидно);

	// Тогда
	Ожидаем.Что(Валидация.ЗначениеВалидно(Валидный)).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(Невалидный)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура БазоваяВалидацияТребуетРеализации() Экспорт

	// Дано
	Валидация = Новый ВалидацияОграничения;
	Валидация.Инициализировать(Новый АннотацияЗаполнено);

	// Когда
	ОшибкаВозникла = Ложь;
	Попытка
		Валидация.ЗначениеВалидно("значение");
	Исключение
		ОшибкаВозникла = Истина;
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ОшибкаВозникла).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВалидаторИспользуетПереданнуюФабрику() Экспорт

	// Дано
	// Фабрика распознаёт только &Заполнено, остальная разметка объекта
	// для неё ограничениями не является.
	Валидатор = Новый Валидатор(Новый ФабрикаТолькоЗаполнено);

	Объект = Новый ТестовыйОбъект;
	Объект.Поле4 = "не число, но проверять тип некому";

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Объект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(2);
	Ожидаем.Что(РезультатВалидации[0].Код()).Равно("filled");
	Ожидаем.Что(РезультатВалидации[1].Код()).Равно("filled");

КонецПроцедуры

&Тест
Процедура ВалидаторИспользуетПереданныйКонтейнерАннотаций() Экспорт

	// Дано
	// В пустом контейнере не зарегистрировано ни одной аннотации, поэтому
	// разметка объекта валидатору ни о чём не говорит.
	Валидатор = Новый Валидатор(Неопределено, Новый КонтейнерАннотаций);

	// Когда
	РезультатВалидации = Валидатор.Валидировать(Новый ТестовыйОбъект);

	// Тогда
	Ожидаем.Что(РезультатВалидации).ИмеетДлину(0);

КонецПроцедуры

Функция НоваяФабрика()
	Возврат Новый СтандартнаяФабрикаВалидаций(Новый Валидатор);
КонецФункции
