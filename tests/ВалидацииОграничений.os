#Область МинимумИМаксимум

&Тест
Процедура МинимумВключаетГраницу() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияМинимум(10));

	Ожидаем.Что(Валидация.ЗначениеВалидно(10)).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(11)).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(9)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура МаксимумВключаетГраницу() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияМаксимум(10));

	Ожидаем.Что(Валидация.ЗначениеВалидно(10)).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(9)).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(11)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ГраницыПропускаютНеопределено() Экспорт

	Ожидаем.Что(НоваяВалидация(Новый АннотацияМинимум(10)).ЗначениеВалидно(Неопределено)).ЭтоИстина();
	Ожидаем.Что(НоваяВалидация(Новый АннотацияМаксимум(10)).ЗначениеВалидно(Неопределено)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ГраницыСравниваютСамиЗначения() Экспорт

	// Границы сравнивают значения, а не их размер: для строк это
	// лексикографическое сравнение.
	Валидация = НоваяВалидация(Новый АннотацияМинимум("б"));

	Ожидаем.Что(Валидация.ЗначениеВалидно("в")).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно("а")).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

