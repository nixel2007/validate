// Проверки самих ограничений, без обхода объекта валидатором:
// граничные случаи удобнее задавать значением, а не разметкой класса.
#Использовать ".."
#Использовать "."
#Использовать asserts

#Область Заполнено

&Тест
Процедура ЗаполненоОтклоняетНезаполненныеЗначения() Экспорт

	Валидация = Новый ВалидацияОграниченияЗаполнено;

	Ожидаем.Что(Валидация.ЗначениеВалидно(Неопределено)).ЭтоЛожь();
	Ожидаем.Что(Валидация.ЗначениеВалидно("")).ЭтоЛожь();
	Ожидаем.Что(Валидация.ЗначениеВалидно(0)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЗаполненоПропускаетЗаполненныеЗначения() Экспорт

	Валидация = Новый ВалидацияОграниченияЗаполнено;

	Ожидаем.Что(Валидация.ЗначениеВалидно("значение")).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(1)).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(Истина)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Размер

&Тест
Процедура РазмерСчитаетДлинуСтроки() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияРазмер(2, 5));

	Ожидаем.Что(Валидация.ЗначениеВалидно("ab")).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно("abcde")).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно("a")).ЭтоЛожь();
	Ожидаем.Что(Валидация.ЗначениеВалидно("abcdef")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура РазмерСчитаетКоличествоЭлементовКоллекции() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияРазмер(1, 2));

	Ожидаем.Что(Валидация.ЗначениеВалидно(МассивИзЭлементов(1))).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(МассивИзЭлементов(2))).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(МассивИзЭлементов(0))).ЭтоЛожь();
	Ожидаем.Что(Валидация.ЗначениеВалидно(МассивИзЭлементов(3))).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура РазмерБезВерхнейГраницыОграничиваетТолькоСнизу() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияРазмер(3));

	Ожидаем.Что(Валидация.ЗначениеВалидно("ab")).ЭтоЛожь();
	Ожидаем.Что(Валидация.ЗначениеВалидно("очень длинное значение")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РазмерПропускаетНеопределено() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияРазмер(3, 5));

	Ожидаем.Что(Валидация.ЗначениеВалидно(Неопределено)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РазмерПрочихЗначенийСчитаетсяПоПредставлению() Экспорт

	// У числа нет метода Количество, поэтому размером считается длина
	// его строкового представления.
	Ожидаем.Что(НоваяВалидация(Новый АннотацияРазмер(1, 100)).ЗначениеВалидно(12345)).ЭтоИстина();
	Ожидаем.Что(НоваяВалидация(Новый АннотацияРазмер(1000)).ЗначениеВалидно(12345)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура РазмерСообщаетОГраницах() Экспорт

	Ожидаем.Что(Новый АннотацияРазмер(2, 5).Сообщение()).Равно("Размер значения вне диапазона <2..5>");
	Ожидаем.Что(Новый АннотацияРазмер(2).Сообщение()).Равно("Размер значения меньше <2>");
	Ожидаем.Что(Новый АннотацияРазмер(2, 5, "Своё").Сообщение()).Равно("Своё");

КонецПроцедуры

#КонецОбласти

#Область Кратно

&Тест
Процедура КратноРаботаетСДробнойКратностью() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияКратно(0.5));

	Ожидаем.Что(Валидация.ЗначениеВалидно(1)).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(1.5)).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(1.2)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура КратноРаботаетСОтрицательнымиЗначениями() Экспорт

	Валидация = НоваяВалидация(Новый АннотацияКратно(3));

	Ожидаем.Что(Валидация.ЗначениеВалидно(-9)).ЭтоИстина();
	Ожидаем.Что(Валидация.ЗначениеВалидно(-10)).ЭтоЛожь();
	Ожидаем.Что(Валидация.ЗначениеВалидно(0)).ЭтоИстина();

КонецПроцедуры

