#Область ПрограммныйИнтерфейс

Перем Минимум;
Перем Максимум;

Процедура Инициализировать(пОграничение) Экспорт
	Минимум = пОграничение.Минимум();
	Максимум = пОграничение.Максимум();
КонецПроцедуры

Функция ЗначениеВалидно(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Размер = РазмерЗначения(Значение);

	Если Размер < Минимум Тогда
		Возврат Ложь;
	КонецЕсли;

	// Ноль сверху означает отсутствие ограничения: иначе пришлось бы указывать
	// заведомо большое число там, где верхней границы просто нет.
	Возврат Максимум = 0 ИЛИ Размер <= Максимум;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Размером коллекции считается количество элементов, размером всего
// остального - длина строкового представления.
Функция РазмерЗначения(Значение)

	Попытка
		Возврат Значение.Количество();
	Исключение
		Возврат СтрДлина(Строка(Значение));
	КонецПопытки;

КонецФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти
