// Строка - Сообщение, выводимое при невалидном значении
//
Перем _Сообщение;

// Число, кратным которому должно быть значение
Перем _Кратность;

// Представление имени ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяОграничения() Экспорт
	Возврат "Кратно";
КонецФункции

// Сообщение, показываемое при срабатывании ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Сообщение() Экспорт
	Возврат _Сообщение;
КонецФункции

// Код ограничения
//
// Возвращаемое значение:
//   Строка
//
Функция Код() Экспорт
	Возврат "multipleOf";
КонецФункции

// Число, кратным которому должно быть значение.
//
// Возвращаемое значение:
//   Число
//
Функция Кратность() Экспорт
	Возврат _Кратность;
КонецФункции

// Аннотация ограничения значения свойства или элементов/ключей коллекции.
//
// Проаннотированный элемент должен быть кратен указанному числу. Кратность
// может быть дробной: &Кратно(0.5) допускает 1, 1.5, 2 и не допускает 1.2.
//
// Параметры:
//   Значение    - Число  - число, кратным которому должно быть значение.
//   Сообщение   - Строка - текст сообщения (по умолчанию формируется автоматически).
//
&Аннотация("Кратно")
Процедура ПриСозданииОбъекта(Значение, Сообщение = "")

	// Аргумент проверяется здесь, а не в валидации: неверная разметка - ошибка
	// разработчика, и обнаружиться она должна при разборе аннотации, а не
	// молча превратиться в нарушение у каждого проверяемого значения.
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение "Аннотация &Кратно ожидает число, получено: " + ТипЗнч(Значение);
	КонецЕсли;

	Если Значение = 0 Тогда
		ВызватьИсключение "Аннотация &Кратно не принимает ноль: кратность нулю не определена";
	КонецЕсли;

	_Кратность = Значение;

	Если Сообщение = "" Тогда
		_Сообщение = "Значение не кратно <" + Формат(_Кратность, "ЧГ=0; ЧН=0") + ">";
	Иначе
		_Сообщение = Сообщение;
	КонецЕсли;

КонецПроцедуры
